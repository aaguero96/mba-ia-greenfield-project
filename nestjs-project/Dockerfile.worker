FROM node:25.6.0-slim

# ffmpeg provides both `ffmpeg` and `ffprobe`. It lives only in the worker image —
# the API never invokes them, and the layer is large (see TD-05).
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg procps curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /home/node/app

USER node

CMD [ "tail", "-f", "/dev/null" ]
