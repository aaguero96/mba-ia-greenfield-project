                    },
                    "email": {
                      "type": "string",
                      "format": "email"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Get current user",
        "tags": [
          "auth"
        ]
      }
    },
    "/videos": {
      "post": {
        "description": "Pre-registers the video as a draft and opens a multipart upload. The file itself is uploaded directly to object storage through pre-signed URLs — it never passes through the API.",
        "operationId": "VideosController_initiateUpload",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InitiateUploadDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Draft created and upload opened",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InitiateUploadResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed, or the upload would exceed the part limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "The authenticated user has no channel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Start a video upload",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{publicId}/upload/parts": {
      "post": {
        "description": "Returns one pre-signed URL per requested part. Re-signing is allowed, so a client whose URLs expired resumes instead of restarting the upload.",
        "operationId": "VideosController_signUploadParts",
        "parameters": [
          {
            "name": "publicId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignPartsDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed part URLs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignPartsResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed or a part number is out of range",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The video belongs to another channel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Video not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "The upload is no longer open",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Get pre-signed URLs for upload parts",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{publicId}/upload": {
      "get": {
        "description": "Lists the parts storage already holds, so an interrupted client can skip them when resuming.",
        "operationId": "VideosController_getUploadStatus",
        "parameters": [
          {
            "name": "publicId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Upload state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadStatusResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "The video belongs to another channel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Video not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "The upload is no longer open",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Get the state of an in-progress upload",
        "tags": [
          "videos"
        ]
      },
      "delete": {
        "description": "Aborts the multipart upload and deletes the draft, freeing the parts already stored.",
        "operationId": "VideosController_abortUpload",
        "parameters": [
          {
            "name": "publicId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Upload cancelled"
          },
          "403": {
            "description": "The video belongs to another channel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Video not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "The upload is no longer open",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Cancel an in-progress upload",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{publicId}/upload/complete": {
      "post": {
        "description": "Assembles the uploaded parts, verifies the stored object against the declared size, moves the video to processing and enqueues it for the worker.",
        "operationId": "VideosController_completeUpload",
        "parameters": [
          {
            "name": "publicId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteUploadDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Upload completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The video belongs to another channel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Video not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "The upload is no longer open",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "The stored object does not match the declared size",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Complete a video upload",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{publicId}": {
      "get": {
        "description": "Returns the video and its unique URLs. Only ready videos are visible anonymously; the owner also sees their own drafts.",
        "operationId": "VideosPublicController_getVideo",
        "parameters": [
          {
            "name": "publicId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The video",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Video not found, or not ready and requested by someone else",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Get a video",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{publicId}/stream": {
      "get": {
        "description": "Serves the video with HTTP Range support, so playback starts without downloading the whole file. Without a Range header the full body is returned with Accept-Ranges.",
        "operationId": "VideosPublicController_stream",
        "parameters": [
          {
            "name": "publicId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Full body"
          },
          "206": {
            "description": "Partial content for the requested range"
          },
          "404": {
            "description": "Video not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "416": {
            "description": "The requested range is not satisfiable"
          }
        },
        "summary": "Stream a video",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{publicId}/thumbnail": {
      "get": {
        "description": "Serves the JPEG the worker cut from a frame of the video.",
        "operationId": "VideosPublicController_thumbnail",
        "parameters": [
          {
            "name": "publicId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The thumbnail image"
          },
          "404": {
            "description": "Video not found, or no thumbnail has been generated yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Get the generated thumbnail",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{publicId}/download": {
      "get": {
        "description": "Redirects to a short-lived pre-signed URL. The file is served by object storage, so the full transfer never passes through the API.",
        "operationId": "VideosPublicController_download",
        "parameters": [
          {
            "name": "publicId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the pre-signed URL"
          },
          "404": {
            "description": "Video not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Download a video",
        "tags": [
          "videos"
        ]
      }
    }
  },
  "info": {
    "title": "StreamTube API",
    "description": "API REST do StreamTube",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {}
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "InitiateUploadDto": {
        "type": "object",
        "properties": {}
      },
      "VideoChannelDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nickname": {
            "type": "string",
            "example": "streamtube_user"
          }
        },
        "required": [
          "id",
          "nickname"
        ]
      },
      "VideoMetadataDto": {
        "type": "object",
        "properties": {
          "width": {
            "type": "object",
            "nullable": true,
            "example": 1920
          },
          "height": {
            "type": "object",
            "nullable": true,
            "example": 1080
          },
          "codec": {
            "type": "object",
            "nullable": true,
            "example": "h264"
          },
          "bitrate": {
            "type": "object",
            "nullable": true,
            "example": 4500000
          },
          "formatName": {
            "type": "object",
            "nullable": true,
            "example": "mov,mp4,m4a"
          }
        },
        "required": [
          "width",
          "height",
          "codec",
          "bitrate",
          "formatName"
        ]
      },
      "VideoResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Short unique public identifier",
            "example": "AbCdEfGhIjK"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "object",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "processing",
              "ready",
              "failed"
            ]
          },
          "channel": {
            "$ref": "#/components/schemas/VideoChannelDto"
          },
          "duration_seconds": {
            "type": "object",
            "nullable": true,
            "example": 128.4
          },
          "size_bytes": {
            "type": "string",
            "description": "Size in bytes. A string because the value can exceed the safe integer range.",
            "example": "10737418240"
          },
          "content_type": {
            "type": "string"
          },
          "metadata": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/VideoMetadataDto"
              }
            ]
          },
          "processing_error": {
            "type": "object",
            "nullable": true
          },
          "url": {
            "type": "string",
            "description": "Unique URL of the video"
          },
          "stream_url": {
            "type": "string"
          },
          "download_url": {
            "type": "string"
          },
          "thumbnail_url": {
            "type": "object",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "channel",
          "size_bytes",
          "content_type",
          "url",
          "stream_url",
          "download_url",
          "created_at",
          "updated_at"
        ]
      },
      "UploadPlanDto": {
        "type": "object",
        "properties": {
          "upload_id": {
            "type": "string",
            "description": "S3 multipart upload identifier"
          },
          "part_size": {
            "type": "number",
            "description": "Size of every part but the last, in bytes",
            "example": 67108864
          },
          "part_count": {
            "type": "number",
            "description": "Number of parts the client must upload",
            "example": 160
          }
        },
        "required": [
          "upload_id",
          "part_size",
          "part_count"
        ]
      },
      "InitiateUploadResponseDto": {
        "type": "object",
        "properties": {
          "video": {
            "$ref": "#/components/schemas/VideoResponseDto"
          },
          "upload": {
            "$ref": "#/components/schemas/UploadPlanDto"
          }
        },
        "required": [
          "video",
          "upload"
        ]
      },
      "SignPartsDto": {
        "type": "object",
        "properties": {}
      },
      "SignedPartDto": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number",
            "example": 1
          },
          "url": {
            "type": "string",
            "description": "Pre-signed URL the client PUTs the part to"
          },
          "expires_in": {
            "type": "number",
            "description": "Lifetime of the URL in seconds",
            "example": 21600
          }
        },
        "required": [
          "part_number",
          "url",
          "expires_in"
        ]
      },
      "SignPartsResponseDto": {
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SignedPartDto"
            }
          }
        },
        "required": [
          "parts"
        ]
      },
      "UploadedPartDto": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number",
            "example": 1
          },
          "size": {
            "type": "number",
            "example": 67108864
          },
          "etag": {
            "type": "string",
            "example": "\"9b2cf5…\""
          }
        },
        "required": [
          "part_number",
          "size",
          "etag"
        ]
      },
      "UploadStatusResponseDto": {
        "type": "object",
        "properties": {
          "upload_id": {
            "type": "string"
          },
          "part_size": {
            "type": "number",
            "example": 67108864
          },
          "part_count": {
            "type": "number",
            "example": 160
          },
          "uploaded_parts": {
            "description": "Parts already stored, so a resuming client can skip them",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadedPartDto"
            }
          }
        },
        "required": [
          "upload_id",
          "part_size",
          "part_count",
          "uploaded_parts"
        ]
      },
      "CompleteUploadDto": {
        "type": "object",
        "properties": {}
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
}