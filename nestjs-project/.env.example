# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube" <noreply@streamtube.com>

# Object Storage (MinIO locally, S3-compatible in production)
# S3_ENDPOINT is resolved inside the Compose network; S3_PUBLIC_ENDPOINT is what
# clients resolve. A SigV4 signature binds the host, so the two cannot be merged.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=streamtube
S3_SECRET_KEY=streamtube123
S3_VIDEOS_BUCKET=streamtube-videos
S3_THUMBNAILS_BUCKET=streamtube-thumbnails

# Queue (Redis + BullMQ)
REDIS_HOST=redis
REDIS_PORT=6379

# Video processing
VIDEO_UPLOAD_URL_TTL=21600
VIDEO_PROBE_URL_TTL=3600
VIDEO_DOWNLOAD_URL_TTL=900
VIDEO_THUMBNAIL_PERCENT=0.1
VIDEO_FFMPEG_TIMEOUT_MS=120000
